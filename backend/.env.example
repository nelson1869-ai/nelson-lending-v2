APP_ENV=development
APP_NAME=Lending Nelson V2 API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://lending_v2:lending_v2@127.0.0.1:5432/lending_nelson_v2
TEST_DATABASE_URL=postgresql+asyncpg://lending_v2:lending_v2@127.0.0.1:5432/lending_nelson_v2_test
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-for-local-development-use-a-random-secret
